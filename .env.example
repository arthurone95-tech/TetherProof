# TetherProof - Environment Configuration Template
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# The real `.env` file is excluded from version control by `.gitignore`.
# Never place real credentials in this file. Every value below is a
# placeholder and must be replaced locally or injected by the hosting
# provider in staging and production.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PRODUCT_NAME=TetherProof

# ---------------------------------------------------------------------------
# API server (apps/api)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Comma-separated list of allowed CORS origins for the web client.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase project
# ---------------------------------------------------------------------------
# Project settings -> API. SUPABASE_URL is the project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. Safe to expose to the browser; access is controlled by
# Row Level Security, not by hiding this value.
SUPABASE_ANON_KEY=replace_with_public_anon_key

# Server-only service-role key. Bypasses Row Level Security. Never expose this
# to the browser, never commit it, and never return it from an endpoint.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# ---------------------------------------------------------------------------
# Web client (apps/web)
# ---------------------------------------------------------------------------
# Next.js only reads .env files from apps/web, so apps/web/next.config.ts walks
# up and loads this file from the repository root. Keep one .env at the root.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_key

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase database)
# ---------------------------------------------------------------------------
# Project settings -> Database -> Connection string. Prefer the session pooler
# (port 5432) for the runtime and the direct connection (port 5432, IPv4) for
# migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:replace_me@aws-0-region.pooler.supabase.com:5432/postgres

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Media proof storage (Supabase Storage)
# ---------------------------------------------------------------------------
# Create a PRIVATE bucket. Public buckets would defeat the PII scrubbing and
# access rules described in the security documentation.
STORAGE_PROOFS_BUCKET=work-proofs
STORAGE_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Verification links
# ---------------------------------------------------------------------------
# Lifetime of an SMS/WhatsApp verification link in seconds (default 72 hours).
VERIFICATION_TOKEN_TTL=259200

# Salt for hashing client phone numbers. Only the hash is ever stored; the salt
# is what makes that hash unusable as a lookup table. REQUIRED IN PRODUCTION.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank locally and a random per-process salt is used, with a warning.
VERIFIER_PHONE_SALT=

# Public origin of the web client, used to build the link a client taps.
# Required for SMS dispatch to work. Left blank, no link is sent and the worker
# receives it in the API response instead.
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Trust and anti-fraud engine - Phase 3
# ---------------------------------------------------------------------------
# Distance in km still treated as the same site when comparing a worker's
# submission point with the client's tap.
FRAUD_PROXIMITY_KM=2

# Score at or below which a confirmed proof is marked fraud_blocked.
# Must be strictly between 0 and 1. Keep generous: a false block costs an
# honest worker a real verification.
FRAUD_BLOCK_BELOW=0.25

# ---------------------------------------------------------------------------
# Outbound messaging - Phase 3
# ---------------------------------------------------------------------------
# "twilio" sends real SMS. "log" writes the link to the server log instead and
# sends nothing, which is the safe default for an unconfigured deployment.
MESSAGING_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Telemetry connectors (OAuth2) - Phase 2
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_BASE_URL=

# ---------------------------------------------------------------------------
# Messaging gateway (SMS / WhatsApp) - Phase 3
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# ---------------------------------------------------------------------------
# Observability - Phase 5
# ---------------------------------------------------------------------------
LOG_LEVEL=info
