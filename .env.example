# TetherProof - Environment Configuration Template
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# The real `.env` file is excluded from version control by `.gitignore`.
# Never place real credentials in this file. Every value below is a
# placeholder and must be replaced locally or injected by the hosting
# provider in staging and production.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PRODUCT_NAME=TetherProof

# ---------------------------------------------------------------------------
# API server (apps/api)
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000

# In production, API_HOST must be 0.0.0.0 — the default 127.0.0.1 only accepts
# connections from the same machine, which a container's or platform's proxy is
# not, so the service would listen and be unreachable at the same time.

# Comma-separated list of allowed CORS origins for the web client — the browser
# reads this page's data from the API, so the API only grants cross-origin reads
# to origins listed here. List the origin the web app is actually served from:
# `next dev` takes whichever port is free (this machine settled on 3001 when
# another project claimed 3000), and a page on an unlisted port is refused with
# a CORS error instead of a configuration hint. Development accepts loopback and
# private-range origins as well (apps/api/src/lib/origin.ts); production accepts
# only what is written here.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Supabase project
# ---------------------------------------------------------------------------
# Project settings -> API. SUPABASE_URL is the project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. Safe to expose to the browser; access is controlled by
# Row Level Security, not by hiding this value.
SUPABASE_ANON_KEY=replace_with_public_anon_key

# Server-only service-role key. Bypasses Row Level Security. Never expose this
# to the browser, never commit it, and never return it from an endpoint.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# ---------------------------------------------------------------------------
# Web client (apps/web)
# ---------------------------------------------------------------------------
# Next.js only reads .env files from apps/web, so apps/web/next.config.ts walks
# up and loads this file from the repository root. Keep one .env at the root.
#
# The address the browser calls the API on. In development that is this
# machine's API; in production it must be the public API origin
# (https://api.example.com), because this value is read by page code and
# evaluated in the visitor's browser — left at the localhost default, every
# request would be sent to the visitor's own computer.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_public_anon_key

# Canonical origin of the web client, read by BOTH apps: apps/web uses it as the
# address confirmation links return to, and apps/api uses it as one of the
# addresses such links are allowed to point at.
#
# Leave it blank while developing. Blank means "use whichever origin the request
# actually arrived on", so the link follows the port the server started on
# instead of a port written down here — which is what sent confirmation links to
# port 3000 while the application was running on 3001.
#
# Set it in staging and production to the single public address, with no path:
#   NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase database)
# ---------------------------------------------------------------------------
# Project settings -> Database -> Connection string. Prefer the session pooler
# (port 5432) for the runtime and the direct connection (port 5432, IPv4) for
# migrations.
DATABASE_URL=postgresql://postgres.your-project-ref:replace_me@aws-0-region.pooler.supabase.com:5432/postgres

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Media proof storage (Supabase Storage)
# ---------------------------------------------------------------------------
# Create PRIVATE buckets. Public buckets would defeat the PII scrubbing and
# access rules described in the security documentation.
#
# The two buckets are applied to a project by `npm run storage:ensure-bucket`
# (apps/api/scripts/ensure-proof-bucket.ts), which writes the size caps and MIME
# allow-lists below directly into storage.buckets.
STORAGE_PROOFS_BUCKET=work-proofs
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_AVATARS_BUCKET=profile-avatars
STORAGE_MAX_AVATAR_BYTES=5242880

# ---------------------------------------------------------------------------
# Verification links
# ---------------------------------------------------------------------------
# Lifetime of an SMS/WhatsApp verification link in seconds (default 72 hours).
VERIFICATION_TOKEN_TTL=259200

# Salt for hashing client phone numbers. Only the hash is ever stored; the salt
# is what makes that hash unusable as a lookup table. REQUIRED IN PRODUCTION.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank locally and a random per-process salt is used, with a warning.
VERIFIER_PHONE_SALT=

# Public origin of the web client, used to build the link a client taps.
# Required for SMS dispatch to work. Left blank, no link is sent and the worker
# receives it in the API response instead.
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Trust and anti-fraud engine - Phase 3
# ---------------------------------------------------------------------------
# Distance in km still treated as the same site when comparing a worker's
# submission point with the client's tap.
FRAUD_PROXIMITY_KM=2

# Score at or below which a confirmed proof is marked fraud_blocked.
# Must be strictly between 0 and 1. Keep generous: a false block costs an
# honest worker a real verification.
FRAUD_BLOCK_BELOW=0.25

# ---------------------------------------------------------------------------
# Outbound messaging - Phase 3
# ---------------------------------------------------------------------------
# "twilio" sends real SMS. "log" writes the link to the server log instead and
# sends nothing, which is the safe default for an unconfigured deployment.
MESSAGING_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Telemetry connectors (OAuth2) - Phase 2
# ---------------------------------------------------------------------------
# Reserved for the GitHub and Jira connectors described in the PRD. Nothing in
# the codebase reads these keys yet — the connector is specified but not built —
# so filling them in has no effect. Listed so the shape of the future config is
# not a surprise, and so nobody wires up OAuth credentials expecting them to do
# something.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_BASE_URL=

# ---------------------------------------------------------------------------
# Observability - Phase 5
# ---------------------------------------------------------------------------
LOG_LEVEL=info
